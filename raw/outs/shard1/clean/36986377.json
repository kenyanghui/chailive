{"file":"36986377.json","book_id":36986377,"memoirs":[{"id":19932,"topic":"从未来的视角看见孩子","learn_goal":"","remark":"全国教育看海淀，这是一本海淀家长的家庭教育成功范例书。作者的孩子2019年以裸分706分、北京市前5名的优秀成绩被清华大学录取，本科阶段又直博北大。\n\n在本书中，作者从孩子出生写起，回忆了孩子从牙牙学语一直到清华毕业、即将去北大读博的心路历程，介绍了父母在陪伴孩子成长的婴儿期、幼儿期、小学、初中、高中、大学等不同阶段的具体做法和心得体会，突出强调了培养孩子良好的学习与生活习惯、与孩子保持全程互动交流，以及对手机、电脑的使用与管控等方面的重要性，有事例，有点评，有提醒，有建议，完整展示了全国瞩目的海淀家长是如何人性化“鸡娃”，全国领先的海淀教育引导孩子全面发展的真相。","level":"","duration":180,"status":0,"type":0,"chaishujia":{"username":"张军","city":"常州市"},"club":{"name":"常州龙城分舵","city":"常州"},"book":{"id":36986377,"title":"一路陪伴到清北","author":"周俞波","translator":"","publisher":"北京联合出版有限公司","pubdate":"2024-8","isbn":"9787559675415","tags":["教育"],"memCount":null},"prologue":"<p>在</p>","ratings_count":0,"texts":[{"id":24374,"quote":"<p>在</p>","explains":"<p>在</p>","interaction":"<p> 在</p>","flags":{"r":true,"i":true,"a":true,"a1":false,"a2":false,"a3":false}},{"id":24375,"quote":"<p>在</p>","explains":"<p>在</p>","interaction":"<p>在</p>","flags":{"r":true,"i":true,"a":true,"a1":false,"a2":false,"a3":false}}],"created_at":1780874417000,"updated_at":1780874435000},{"id":19324,"topic":"一路陪伴到清北","learn_goal":"","remark":"一路陪伴到清北","level":"","duration":180,"status":20,"type":0,"chaishujia":{"username":"文子飞飞","city":"南京市"},"club":{"name":"南京玄武分舵","city":"南京"},"book":{"id":36986377,"title":"一路陪伴到清北","author":"周俞波","translator":"","publisher":"北京联合出版有限公司","pubdate":"2024-8","isbn":"9787559675415","tags":["教育"],"memCount":null},"prologue":null,"ratings_count":1,"texts":[{"id":23682,"quote":null,"explains":null,"interaction":null,"flags":{"r":false,"i":false,"a":false,"a1":false,"a2":false,"a3":false}}],"created_at":1758588470000,"updated_at":1758672731000}]}